# ============================================================
# AI Assistant - Environment Variables Template
# Copy this file to .env and fill in the values
# ============================================================

# ----- MySQL -----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root

# ----- Redis -----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- Nacos -----
NACOS_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=

# ----- Kafka -----
KAFKA_ADDR=127.0.0.1:9092

# ----- MinIO -----
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ----- PostgreSQL (Vector Store) -----
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres

# ----- MinerU (Document Parse via Nginx) -----
MINERU_NGINX_URL=http://127.0.0.1:80/api/document/parse

# ----- DashScope (Agent only) -----
DASHSCOPE_API_KEY=

# ----- Frontend -----
VITE_API_BASE_URL=
